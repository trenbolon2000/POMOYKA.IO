# Помойка — переменные окружения.
# Локально: скопировать в .env. В проде: GitHub Secrets. В код не коммитить.

# --- Supabase (нужно с шага 2) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- LLM (нужно с шага 3). OpenAI-совместимый эндпоинт. ---
# Сейчас: DeepSeek. Для OpenAI — https://api.openai.com/v1 и модель gpt-*.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Telegram (нужно с шага 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=
OWNER_CHAT_ID=

# --- Дайджест (нужно с шага 5) ---
DIGEST_HOUR_UTC=
