# Помойка — переменные окружения.
# Локально: скопировать в .env. В проде: GitHub Secrets. В код не коммитить.

# --- Supabase (нужно с шага 2) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- LLM (нужно с шага 3). OpenAI-совместимый эндпоинт. ---
# Сейчас: DeepSeek. Для OpenAI — https://api.openai.com/v1 и модель gpt-*.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Telegram (нужно с шага 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel
TELEGRAM_CHANNEL_USERNAME=your_channel
OWNER_CHAT_ID=

# --- Дайджест (нужно с шага 5) ---
# Час UTC для суточного дайджеста. Само расписание — в .github/workflows/digest.yml
# (GitHub cron не читает .env); держим значение здесь как единый источник правды.
DIGEST_HOUR_UTC=18
